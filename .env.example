# The absolute origin this deployment is actually served from, no trailing slash.
# Canonical tags, the sitemap, robots.txt and metadataBase are all built from it.
# If it names a domain that does not host the app, Google is told to index a page
# that is not there and nothing gets indexed. Set it per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification token, meta-tag method. Leave blank to omit
# the tag entirely. The HTML-file method also works: drop google<token>.html into
# public/ and it is served from the site root.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Consultation delivery -------------------------------------------------
# At least ONE destination below must be configured in production. If none is
# configured, consultation submissions fail loudly rather than silently
# discarding the applicant's request.

# Klar CRM — the single system of record. Preferred.
KLAR_CRM_API_URL=
KLAR_CRM_API_TOKEN=
KLAR_CRM_TENANT_ID=
KLAR_CRM_CONSULTATION_ENDPOINT=/api/v1/consultations
KLAR_CRM_TIMEOUT_MS=10000

# Fallback: direct Klar Travels consultation API.
KLAR_CONSULTATION_API_URL=
KLAR_CONSULTATION_API_TOKEN=

# Fallback: generic webhook receiver.
VISAWORX_CONSULTATION_WEBHOOK_URL=

# Local development only. Accepts submissions without a real destination so the
# flow can be exercised offline. Has no effect when NODE_ENV=production.
VISAWORX_ALLOW_DEV_FALLBACK=true

# --- AI assistant ----------------------------------------------------------
# Without AI_API_KEY the assistant degrades to retrieval over approved content.
AI_API_KEY=
AI_PROVIDER_ENDPOINT=
AI_MODEL=
AI_TIMEOUT_MS=15000
